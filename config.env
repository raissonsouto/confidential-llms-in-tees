# Template for the settable variables. Copy it to .env at the repo root and
# fill in your values:
#
#     cp config.env .env
#
# .env is gitignored -- never commit a file containing a real token.
# host_setup.sh and the AZURE.md deployment commands read from .env.

# Hugging Face access token ('read' role is enough; the account must have
# accepted Meta's license for the Llama models -- see README, section
# "Hugging Face access token").
HUGGINGFACE_TOKEN=

##### Azure deployment (see AZURE.md) #####

# AZURE_REGION is only the resource group's location (metadata). Each VM
# deploys into its own *_REGION below, since quota for the two VM families
# is often granted in different regions.
AZURE_RESOURCE_GROUP=rg-llm-bench
AZURE_REGION=eastus
AZURE_ADMIN_USER=azureuser

SGX_VM_NAME=sgx-vm
SGX_VM_SIZE=Standard_DC16s_v3
SGX_VM_REGION=eastus2

TDX_VM_NAME=tdx-vm
TDX_VM_SIZE=Standard_DC16es_v6
TDX_VM_REGION=eastus2
