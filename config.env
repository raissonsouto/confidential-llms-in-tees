# Template for the settable variables. Copy it to .env at the repo root and
# fill in your values:
#
#     cp config.env .env
#
# .env is gitignored -- never commit a file containing a real token.
# host_setup.sh and the AZURE.md deployment commands read from .env.

# Hugging Face access token ('read' role is enough; the account must have
# accepted Meta's license for the Llama models -- see README, section
# "Hugging Face access token").
HUGGINGFACE_TOKEN=

##### Azure deployment (see AZURE.md) #####

# AZURE_REGION is only the resource group's location (metadata). Each VM
# deploys into its own *_REGION below, since quota for the two VM families
# is often granted in different regions.
AZURE_RESOURCE_GROUP=rg-llm-bench
AZURE_REGION=eastus
AZURE_ADMIN_USER=azureuser

SGX_VM_NAME=sgx-vm
SGX_VM_SIZE=Standard_DC16s_v3
SGX_VM_REGION=eastus2

TDX_VM_NAME=tdx-vm
TDX_VM_SIZE=Standard_DC16es_v6
TDX_VM_REGION=eastus2

##### Google Cloud deployment (see GOOGLE_CLOUD.md) #####

# GCP project that holds the H100 quota. GCP_ZONE must be one of the three
# zones where Confidential VM with GPU is supported -- us-central1-a,
# us-east5-a or europe-west4-c. preflight.sh picks the first of those with
# quota if you leave GCP_ZONE empty.
GCP_PROJECT=
GCP_ZONE=us-central1-a

# Both arms use the same shape so the only difference between them is the TEE.
# a3-highgpu-1g (1x H100 80GB, 26 vCPU, 234 GB) is the only machine type that
# supports Confidential VM with an H100, and it exists only as Spot/flex-start.
GPU_MACHINE_TYPE=a3-highgpu-1g

# Google's example uses --boot-disk-size=30G, which is far too small once the
# driver, torch and the 13.5 GB of Llama-2-7B weights are on disk.
GPU_BOOT_DISK_SIZE=200GB

# Only ubuntu-2204-lts and cos-tdx-113-lts are supported with GPUs. Other
# images are tagged TDX_CAPABLE but are explicitly unsupported in that combo.
GPU_IMAGE_PROJECT=ubuntu-os-cloud
GPU_IMAGE_FAMILY=ubuntu-2204-lts

GPU_VM_NAME=gpu-vm
CGPU_VM_NAME=cgpu-vm
